---
import type { Lang } from '../i18n/ui';
import { t, pathFor } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="experiencia" class="bg-surface px-5 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        {t(lang, 'experienceTitle')}
      </h2>
      <p class="mt-3 text-muted leading-relaxed">{t(lang, 'experienceLead')}</p>
    </div>

    <article class="relative rounded-3xl border border-line bg-paper/60 p-6 sm:p-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
        <div>
          <h3 class="font-display text-xl font-bold text-ocean">{t(lang, 'expCompany')}</h3>
          <p class="mt-1 font-medium text-ink-soft">{t(lang, 'expRole')}</p>
        </div>
        <p class="text-sm text-muted">{t(lang, 'expDates')}</p>
      </div>
      <ul class="mt-5 space-y-2.5 text-ink-soft leading-relaxed">
        <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide"></span>{t(lang, 'expBullet1')}</li>
        <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide"></span>{t(lang, 'expBullet2')}</li>
        <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide"></span>{t(lang, 'expBullet3')}</li>
      </ul>
      <a
        href={pathFor(lang, 'byla')}
        class="mt-6 inline-flex text-sm font-semibold text-tide transition hover:text-ocean"
      >
        {t(lang, 'readCase')} →
      </a>
    </article>
  </div>
</section>
