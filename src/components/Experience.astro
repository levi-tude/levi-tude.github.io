---
import type { Lang } from '../i18n/ui';
import { t, pathFor } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const chips = ['React', 'TypeScript', 'Node/Express', 'Supabase', 'n8n', 'Vercel', 'Render'];
---

<section id="experiencia" class="section-y bg-surface px-5">
  <div class="mx-auto max-w-6xl">
    <div class="reveal-on-scroll mb-10 max-w-2xl">
      <h2 class="type-title tracking-tight text-ink">
        {t(lang, 'experienceTitle')}
      </h2>
      <p class="mt-3 text-muted leading-relaxed">{t(lang, 'experienceLead')}</p>
    </div>

    <article class="reveal-on-scroll relative rounded-3xl border border-line bg-paper/60 p-6 sm:p-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
        <div>
          <h3 class="font-display text-xl font-bold text-ocean">{t(lang, 'expCompany')}</h3>
          <p class="mt-1 font-medium text-ink-soft">{t(lang, 'expRole')}</p>
        </div>
        <p class="text-sm text-muted">{t(lang, 'expDates')}</p>
      </div>
      <ul class="mt-5 space-y-2.5 text-ink-soft leading-relaxed">
        <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide" aria-hidden="true"></span>{t(lang, 'expBullet1')}</li>
        <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide" aria-hidden="true"></span>{t(lang, 'expBullet2')}</li>
        <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide" aria-hidden="true"></span>{t(lang, 'expBullet3')}</li>
      </ul>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label={t(lang, 'skillsTitle')}>
        {
          chips.map((c) => (
            <li class="rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-ink-soft">{c}</li>
          ))
        }
      </ul>
      <a
        href={pathFor(lang, 'byla')}
        class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-tide transition hover:text-ocean focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
      >
        {t(lang, 'readCase')} →
      </a>
    </article>
  </div>
</section>
