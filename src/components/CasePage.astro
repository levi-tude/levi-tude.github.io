---
/**
 * Shared case-study chrome aligned with home visual system.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang, UiKey } from '../i18n/ui';
import { t, pathFor } from '../i18n/ui';

interface Shot {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  lang: Lang;
  titleKey: UiKey;
  badgeKey: UiKey;
  leadKey: UiKey;
  stackKey: UiKey;
  problemTitleKey: UiKey;
  problemKey: UiKey;
  solutionTitleKey: UiKey;
  solutionKeys: UiKey[];
  buildTitleKey?: UiKey;
  buildKeys?: UiKey[];
  evalTitleKey?: UiKey;
  evalKeys?: UiKey[];
  nextNoteKey?: UiKey;
  ctaHref: string;
  ctaLabelKey: UiKey;
  articleHref?: string;
  articleLabelKey?: UiKey;
  uiShots: Shot[];
  diagramShots?: Shot[];
  showDemoNote?: boolean;
  galleryTitle?: string;
  diagramsTitle?: string;
}

const {
  lang,
  titleKey,
  badgeKey,
  leadKey,
  stackKey,
  problemTitleKey,
  problemKey,
  solutionTitleKey,
  solutionKeys,
  buildTitleKey,
  buildKeys = [],
  evalTitleKey,
  evalKeys = [],
  nextNoteKey,
  ctaHref,
  ctaLabelKey,
  articleHref,
  articleLabelKey,
  uiShots,
  diagramShots = [],
  showDemoNote = false,
  galleryTitle,
  diagramsTitle,
} = Astro.props;

const pageTitle = `${t(lang, titleKey)} — Levi Tude`;
---

<BaseLayout lang={lang} title={pageTitle}>
  <article class="border-b border-line bg-paper">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <a
        href={pathFor(lang, 'home')}
        class="inline-flex min-h-11 items-center text-sm font-semibold text-tide transition hover:text-ocean focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
      >
        {t(lang, 'backHome')}
      </a>

      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.16em] text-tide">{t(lang, badgeKey)}</p>
      <h1 class="type-title mt-2 text-ink text-balance">
        {t(lang, titleKey)}
      </h1>
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-ink-soft">{t(lang, leadKey)}</p>
      <p class="mt-2 text-sm text-muted leading-relaxed">{t(lang, stackKey)}</p>

      <div class="mt-10 space-y-9">
        <section>
          <h2 class="font-display text-xl font-bold text-ink">{t(lang, problemTitleKey)}</h2>
          <p class="mt-2 leading-relaxed text-ink-soft">{t(lang, problemKey)}</p>
        </section>
        <section>
          <h2 class="font-display text-xl font-bold text-ink">{t(lang, solutionTitleKey)}</h2>
          <ul class="mt-3 list-disc space-y-2.5 pl-5 leading-relaxed text-ink-soft">
            {solutionKeys.map((k) => <li>{t(lang, k)}</li>)}
          </ul>
        </section>
        {
          buildTitleKey && buildKeys.length > 0 && (
            <section>
              <h2 class="font-display text-xl font-bold text-ink">{t(lang, buildTitleKey)}</h2>
              <ul class="mt-3 list-disc space-y-2.5 pl-5 leading-relaxed text-ink-soft">
                {buildKeys.map((k) => (
                  <li>{t(lang, k)}</li>
                ))}
              </ul>
            </section>
          )
        }
        {
          evalTitleKey && evalKeys.length > 0 && (
            <section>
              <h2 class="font-display text-xl font-bold text-ink">{t(lang, evalTitleKey)}</h2>
              <ul class="mt-3 list-disc space-y-2.5 pl-5 leading-relaxed text-ink-soft">
                {evalKeys.map((k) => (
                  <li>{t(lang, k)}</li>
                ))}
              </ul>
            </section>
          )
        }
        {
          nextNoteKey && (
            <p class="rounded-2xl border border-line bg-foam/80 px-4 py-3 text-sm leading-relaxed text-muted">
              {t(lang, nextNoteKey)}
            </p>
          )
        }
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-ocean px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-tide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide sm:w-auto"
        >
          {t(lang, ctaLabelKey)}
        </a>
        {
          articleHref && articleLabelKey && (
            <a
              href={articleHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-semibold text-ink-soft transition hover:border-tide hover:text-tide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide sm:w-auto"
            >
              {t(lang, articleLabelKey)}
            </a>
          )
        }
      </div>
    </div>

    <div class="border-t border-line bg-surface px-5 py-12 sm:py-14">
      <div class="mx-auto max-w-6xl">
        {
          showDemoNote && (
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-tide">{t(lang, 'demoNote')}</p>
          )
        }
        {galleryTitle && <h2 class="mb-5 font-display text-lg font-bold text-ink">{galleryTitle}</h2>}
        <div class="grid gap-5 sm:grid-cols-2">
          {
            uiShots.map((s, i) => (
              <figure
                class:list={[
                  'overflow-hidden rounded-2xl border border-line bg-paper',
                  i === 0 && 'sm:col-span-2',
                ]}
              >
                <div class:list={[i === 0 ? 'media-frame rounded-none shadow-none' : '']}>
                  <img
                    src={s.src}
                    alt={s.alt}
                    class:list={[
                      'w-full',
                      i === 0
                        ? 'case-hero-shot img-lift max-h-[min(28rem,70vh)] object-contain bg-foam sm:object-cover sm:object-top'
                        : 'object-cover object-top',
                    ]}
                    loading="lazy"
                    width="1200"
                    height="675"
                  />
                </div>
                {s.caption && (
                  <figcaption class="type-caption border-t border-line/70 px-4 py-3.5 text-sm leading-relaxed text-muted">
                    {s.caption}
                  </figcaption>
                )}
              </figure>
            ))
          }
        </div>

        {
          diagramShots.length > 0 && (
            <div class="mt-10">
              {diagramsTitle && <h2 class="mb-5 font-display text-lg font-bold text-ink">{diagramsTitle}</h2>}
              <div class="grid gap-5 sm:grid-cols-2">
                {diagramShots.map((s) => (
                  <figure class="overflow-hidden rounded-2xl border border-line bg-paper">
                    <img src={s.src} alt={s.alt} class="w-full object-contain bg-foam p-3 sm:p-4" loading="lazy" />
                    {s.caption && (
                      <figcaption class="type-caption border-t border-line/70 px-4 py-3.5 text-sm leading-relaxed text-muted">
                        {s.caption}
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
