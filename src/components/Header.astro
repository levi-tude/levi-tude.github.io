---
import type { Lang } from '../i18n/ui';
import { t, otherLang, pathFor, routes } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const switchTo = otherLang(lang);
const home = pathFor(lang, 'home');
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
    <a href={home} class="font-display text-lg font-bold tracking-tight text-ocean">
      {t(lang, 'brand')}
    </a>
    <nav class="flex items-center gap-0.5 text-sm text-ink-soft sm:gap-1">
      <a class="hidden rounded-lg px-2.5 py-1.5 transition hover:bg-tide-soft hover:text-tide sm:inline" href={`${home}#experiencia`}>
        {t(lang, 'navExperience')}
      </a>
      <a class="rounded-lg px-2.5 py-1.5 transition hover:bg-tide-soft hover:text-tide" href={`${home}#projetos`}>
        {t(lang, 'navProjects')}
      </a>
      <a class="rounded-lg px-2.5 py-1.5 transition hover:bg-tide-soft hover:text-tide" href={`${home}#sobre`}>
        {t(lang, 'navAbout')}
      </a>
      <a class="rounded-lg px-2.5 py-1.5 transition hover:bg-tide-soft hover:text-tide" href={`${home}#contato`}>
        {t(lang, 'navContact')}
      </a>
      <a
        class="ml-1 rounded-lg border border-line px-2.5 py-1.5 font-medium text-tide transition hover:border-tide hover:bg-tide-soft"
        href={routes[switchTo].home}
        hreflang={switchTo === 'pt' ? 'pt-BR' : 'en'}
      >
        {t(lang, 'langLabel')}
      </a>
    </nav>
  </div>
</header>
