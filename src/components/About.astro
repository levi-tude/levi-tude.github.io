---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const skills = [
  'TypeScript',
  'React',
  'Node.js',
  'Express',
  'Supabase',
  'PostgreSQL',
  'n8n',
  'Next.js',
  'Flask',
  'Gemini',
  'Tailwind',
  'Vercel',
  'Render',
];
---

<section id="sobre" class="border-y border-ocean/8 bg-foam px-5 py-20">
  <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <h2 class="font-display text-3xl font-bold tracking-tight text-ocean sm:text-4xl">
        {t(lang, 'aboutTitle')}
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        {t(lang, 'aboutBody')}
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-tide">{t(lang, 'skillsTitle')}</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          skills.map((s) => (
            <li class="rounded-full border border-ocean/10 bg-white px-3 py-1.5 text-sm text-ocean/90">{s}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
