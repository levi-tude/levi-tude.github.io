---
import type { Lang } from '../i18n/ui';
import { t, pathFor } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="ocean-gradient wave-mask relative overflow-hidden text-foam">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 pb-28 pt-16 sm:pb-32 sm:pt-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-14">
    <div class="space-y-6">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-tide-bright">
        {t(lang, 'heroRole')}
      </p>
      <h1 class="font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-6xl">
        Levi Davi Tude Silva
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-mist/95 text-balance">
        {t(lang, 'heroLead')}
      </p>
      <p class="text-sm text-mist/70">{t(lang, 'heroLocation')}</p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href="#projetos"
          class="inline-flex items-center rounded-full bg-tide-bright px-5 py-2.5 text-sm font-semibold text-ink transition hover:brightness-110"
        >
          {t(lang, 'heroCtaProjects')}
        </a>
        <a
          href="#contato"
          class="inline-flex items-center rounded-full border border-foam/30 px-5 py-2.5 text-sm font-semibold text-foam transition hover:border-foam/60 hover:bg-white/5"
        >
          {t(lang, 'heroCtaContact')}
        </a>
      </div>
    </div>

    <div class="justify-self-center lg:justify-self-end">
      <div
        class="flex h-52 w-52 flex-col items-center justify-center rounded-full border border-white/15 bg-white/5 text-center shadow-[0_0_0_12px_rgba(45,179,168,0.08)] sm:h-60 sm:w-60"
        aria-label={t(lang, 'heroPhotoSoon')}
      >
        <span class="font-display text-4xl font-bold text-tide-bright">LT</span>
        <span class="mt-2 text-xs uppercase tracking-widest text-mist/60">{t(lang, 'heroPhotoSoon')}</span>
      </div>
    </div>
  </div>
</section>
