---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="mesh-hero relative overflow-hidden border-b border-line">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-[var(--section-y)] lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
    <div class="reveal">
      <p class="text-sm font-semibold text-tide">{t(lang, 'heroGreeting')}</p>
      <h1 class="type-display mt-2 text-ink text-balance">
        {t(lang, 'heroName')}
      </h1>
      <p class="mt-3 font-display text-lg font-bold tracking-tight text-ocean sm:text-xl">
        {t(lang, 'heroRole')}
      </p>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft text-balance">
        {t(lang, 'heroLead')}
      </p>
      <p class="mt-3 text-sm text-muted">{t(lang, 'heroLocation')}</p>
      <p class="mt-4 max-w-xl text-sm font-medium leading-relaxed text-ocean/80">{t(lang, 'heroStackHint')}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="#projetos"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-tide px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-ocean focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide sm:w-auto"
        >
          {t(lang, 'heroCtaProjects')}
        </a>
        <a
          href="#contato"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-tide hover:text-tide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide sm:w-auto"
        >
          {t(lang, 'heroCtaContact')}
        </a>
        <a
          href="/cv/Levi-Davi-Tude-Silva.pdf"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-transparent px-5 py-2.5 text-sm font-semibold text-muted underline-offset-4 transition hover:text-tide hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide sm:w-auto"
          download
        >
          {t(lang, 'heroCtaCv')}
        </a>
      </div>
    </div>

    <div class="reveal reveal-delay-2 justify-self-center lg:justify-self-end">
      <figure class="relative w-full max-w-[14.5rem] sm:max-w-[17rem] lg:max-w-[19rem]">
        <div class="absolute -inset-3 rounded-[2rem] bg-tide/10 blur-2xl" aria-hidden="true"></div>
        <img
          src="/images/levi-about.jpg"
          alt={t(lang, 'heroPhotoAlt')}
          width="800"
          height="1709"
          class="relative aspect-[3/5] w-full rounded-[1.75rem] object-cover object-center shadow-[0_24px_60px_rgba(10,22,32,0.18)] ring-1 ring-line"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>
