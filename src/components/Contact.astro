---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const links = [
  {
    label: t(lang, 'email'),
    href: 'mailto:levidavitudesilva@gmail.com',
    value: 'levidavitudesilva@gmail.com',
  },
  {
    label: t(lang, 'linkedin'),
    href: 'https://www.linkedin.com/in/levi-davi-tude-silva/',
    value: 'linkedin.com/in/levi-davi-tude-silva',
  },
  {
    label: t(lang, 'github'),
    href: 'https://github.com/levi-tude',
    value: 'github.com/levi-tude',
  },
];
---

<section id="contato" class="bg-sand px-5 py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-display text-3xl font-bold tracking-tight text-ocean sm:text-4xl">
      {t(lang, 'contactTitle')}
    </h2>
    <p class="mt-3 text-muted">{t(lang, 'contactLead')}</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="group block rounded-2xl border border-ocean/10 bg-white px-5 py-5 transition hover:border-tide/50 hover:shadow-sm"
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-tide">{l.label}</span>
              <span class="mt-2 block break-all text-sm font-medium text-ocean group-hover:text-tide">
                {l.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
