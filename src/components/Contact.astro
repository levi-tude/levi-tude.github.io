---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="contato" class="border-t border-line bg-ocean px-5 py-16 text-foam sm:py-20">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
      {t(lang, 'contactTitle')}
    </h2>
    <p class="mt-3 max-w-xl text-mist/90 leading-relaxed">{t(lang, 'contactLead')}</p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="mailto:levidavitudesilva@gmail.com"
        class="inline-flex min-h-11 items-center rounded-full bg-tide px-6 py-3 text-sm font-semibold text-white transition hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foam"
      >
        {t(lang, 'contactCta')}
      </a>
      <a
        href="https://www.linkedin.com/in/levi-davi-tude-silva/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center text-sm font-semibold text-mist transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foam"
      >
        {t(lang, 'linkedin')} ↗
      </a>
      <a
        href="https://github.com/levi-tude"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center text-sm font-semibold text-mist transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foam"
      >
        {t(lang, 'github')} ↗
      </a>
      <a
        href="/cv/Levi-Davi-Tude-Silva.pdf"
        class="inline-flex min-h-11 items-center text-sm font-semibold text-mist transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foam"
        download
      >
        {t(lang, 'heroCtaCv')} ↓
      </a>
    </div>
  </div>
</section>
