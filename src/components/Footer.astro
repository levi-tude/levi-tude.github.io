---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="border-t border-white/10 bg-ink text-mist">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p class="font-display font-semibold text-foam">Levi Davi Tude Silva</p>
    <p class="text-mist/70">{t(lang, 'footerNote')}</p>
  </div>
</footer>
