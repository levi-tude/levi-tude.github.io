---
import type { Lang } from '../i18n/ui';
import { t, pathFor } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const secondary = [
  {
    kind: 'stella' as const,
    badge: t(lang, 'explBadge'),
    title: t(lang, 'explTitle'),
    blurb: t(lang, 'explBlurb'),
    stack: t(lang, 'stackExpl'),
    href: pathFor(lang, 'explicasurf'),
    image: '/images/explicasurf/explicasurf-home-stella.png',
    alt: lang === 'pt' ? 'Home do ExplicaSurf — Stella Maris' : 'ExplicaSurf home — Stella Maris',
    external: 'https://explicasurfstella.com.br' as string | null,
    note: null as string | null,
  },
  {
    kind: 'commercial' as const,
    badge: t(lang, 'commercialBadge'),
    title: t(lang, 'commercialTitle'),
    blurb: t(lang, 'commercialBlurb'),
    stack: t(lang, 'stackCommercial'),
    href: null as string | null,
    image: '/images/explicasurf/explicasurf-gerar-explicacao-ia.png',
    alt: lang === 'pt' ? 'Gerar explicação com IA' : 'Generate AI explanation',
    external: null,
    note: t(lang, 'commercialNote'),
  },
];
---

<section id="projetos" class="section-y border-y border-line bg-paper px-5">
  <div class="mx-auto max-w-6xl">
    <div class="reveal-on-scroll mb-10 max-w-2xl">
      <h2 class="type-title tracking-tight text-ink">{t(lang, 'projectsTitle')}</h2>
      <p class="mt-3 text-muted leading-relaxed">{t(lang, 'projectsLead')}</p>
    </div>

    <article class="reveal-on-scroll overflow-hidden rounded-3xl border border-line bg-surface">
      <div class="grid lg:grid-cols-[1.25fr_0.75fr]">
        <a
          href={pathFor(lang, 'byla')}
          class="block bg-foam p-3 sm:p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
        >
          <div class="media-frame">
            <img
              src="/images/byla/byla-visao-geral.webp"
              alt={lang === 'pt' ? 'Painel Visão geral do Byla (dados fictícios)' : 'Byla overview dashboard (fictional data)'}
              class="img-lift min-h-64 w-full object-cover object-top"
              loading="eager"
              width="1200"
              height="675"
            />
          </div>
        </a>
        <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-tide-soft px-3 py-1 text-xs font-semibold uppercase tracking-wider text-tide">
              {t(lang, 'featuredLabel')}
            </span>
            <span class="rounded-full border border-line px-3 py-1 text-xs font-semibold uppercase tracking-wider text-muted">
              {t(lang, 'bylaBadge')}
            </span>
          </div>
          <h3 class="type-subtitle mt-4 text-ink">{t(lang, 'bylaTitle')}</h3>
          <p class="mt-3 text-ink-soft leading-relaxed">{t(lang, 'bylaBlurb')}</p>
          <p class="mt-2 text-sm font-semibold text-ocean">{t(lang, 'bylaOutcome')}</p>
          <p class="mt-4 text-sm text-muted">{t(lang, 'stackByla')}</p>
          <p class="type-caption mt-2">{t(lang, 'demoNote')}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={pathFor(lang, 'byla')}
              class="inline-flex min-h-11 items-center rounded-full bg-ocean px-4 py-2 text-sm font-semibold text-white transition hover:bg-tide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
            >
              {t(lang, 'readCase')}
            </a>
            <a
              href="https://github.com/levi-tude/Byla-Financeiro"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink-soft transition hover:border-tide hover:text-tide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
            >
              GitHub
            </a>
          </div>
        </div>
      </div>
    </article>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        secondary.map((p) => (
          <article
            class:list={[
              'reveal-on-scroll overflow-hidden rounded-3xl border transition',
              p.kind === 'stella' ? 'border-line bg-surface hover:border-tide/50' : 'border-dashed border-line/80 bg-paper/40',
            ]}
          >
            <div class="border-b border-line bg-foam p-3">
              <div class:list={[p.kind === 'stella' ? 'media-frame' : 'overflow-hidden rounded-xl']}>
                <img
                  src={p.image}
                  alt={p.alt}
                  class:list={['aspect-[16/10] w-full object-cover object-top', p.kind === 'stella' ? 'img-lift' : 'opacity-90']}
                  loading="lazy"
                  width="800"
                  height="500"
                />
              </div>
            </div>
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-tide">{p.badge}</span>
              <h3 class="mt-2 font-display text-xl font-bold text-ink">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.blurb}</p>
              {p.note && <p class="type-caption mt-2 italic">{p.note}</p>}
              <p class="type-caption mt-3">{p.stack}</p>
              <div class="mt-5 flex flex-wrap gap-4">
                {p.external && (
                  <a
                    href={p.external}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold text-tide hover:text-ocean focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
                  >
                    {t(lang, 'visitLive')} ↗
                  </a>
                )}
                {p.href && (
                  <a
                    href={p.href}
                    class="text-sm font-semibold text-ink-soft hover:text-tide focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tide"
                  >
                    {t(lang, 'readCase')} →
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
