---
import CasePage from '../../components/CasePage.astro';

const lang = 'pt' as const;

const uiShots = [
  { src: '/images/byla/byla-visao-geral.webp', alt: 'Visão geral com KPIs fictícios', caption: 'Visão geral — painel executivo (demo)' },
  { src: '/images/byla/byla-fluxo-operacional.webp', alt: 'Fluxo operacional de alunos e pagamentos', caption: 'Fluxo operacional' },
  { src: '/images/byla/byla-entradas.webp', alt: 'Tela de entradas', caption: 'Entradas' },
  { src: '/images/byla/byla-despesas.webp', alt: 'Tela de despesas', caption: 'Despesas' },
  { src: '/images/byla/byla-rbac-admin-ui.webp', alt: 'Menu do perfil admin', caption: 'RBAC — menu admin' },
  { src: '/images/byla/byla-rbac-secretaria-ui.webp', alt: 'Menu restrito da secretaria', caption: 'RBAC — menu secretaria' },
  { src: '/images/byla/byla-relatorio-ia.webp', alt: 'Relatório assistido por IA (demo)', caption: 'Relatório assistido por IA' },
  { src: '/images/byla/byla-mobile.webp', alt: 'Layout mobile do fluxo', caption: 'Layout mobile' },
];

const diagramShots = [
  { src: '/images/byla/byla-arquitetura.svg', alt: 'Diagrama de arquitetura do Byla', caption: 'Arquitetura' },
  { src: '/images/byla/byla-rbac.svg', alt: 'Diagrama de permissões RBAC', caption: 'Matriz de permissões' },
];
---

<CasePage
  lang={lang}
  titleKey="bylaPageTitle"
  badgeKey="bylaBadge"
  leadKey="bylaPageLead"
  stackKey="stackByla"
  problemTitleKey="bylaProblemTitle"
  problemKey="bylaProblem"
  solutionTitleKey="bylaSolutionTitle"
  solutionKeys={['bylaSolution1', 'bylaSolution2', 'bylaSolution3']}
  honestTitleKey="bylaHonestTitle"
  honestKey="bylaHonest"
  ctaHref="https://github.com/levi-tude/Byla-Financeiro"
  ctaLabelKey="bylaRepo"
  uiShots={uiShots}
  diagramShots={diagramShots}
  showDemoNote={true}
  galleryTitle="Interface"
  diagramsTitle="Diagramas"
/>
