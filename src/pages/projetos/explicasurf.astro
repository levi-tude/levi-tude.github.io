---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, pathFor } from '../../i18n/ui';

const lang = 'pt' as const;

const shots = [
  { src: '/images/explicasurf/explicasurf-home-stella.png', alt: 'Home ExplicaSurf — Stella Maris' },
  { src: '/images/explicasurf/explicasurf-condicoes-mar.png', alt: 'Card de condições do mar e tempo' },
  { src: '/images/explicasurf/explicasurf-gerar-explicacao-ia.png', alt: 'Personalizar e gerar explicação com IA' },
  { src: '/images/explicasurf/explicasurf-card-explicacao-ui.png', alt: 'Card de explicação personalizada com TTS' },
  { src: '/images/explicasurf/explicasurf-grafico-ondas.png', alt: 'Gráfico de altura e período das ondas' },
  { src: '/images/explicasurf/explicasurf-grafico-mare.png', alt: 'Gráfico de maré' },
  { src: '/images/explicasurf/explicasurf-login.png', alt: 'Tela de login do ExplicaSurf' },
  { src: '/images/explicasurf/explicasurf-arquitetura.png', alt: 'Diagrama de arquitetura ExplicaSurf' },
];
---

<BaseLayout lang={lang} title={`${t(lang, 'explPageTitle')} — Levi Tude`}>
  <article class="px-5 py-14">
    <div class="mx-auto max-w-3xl">
      <a href={pathFor(lang, 'home')} class="text-sm font-medium text-tide hover:text-tide-bright">{t(lang, 'backHome')}</a>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-tide">{t(lang, 'explBadge')}</p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ocean">{t(lang, 'explPageTitle')}</h1>
      <p class="mt-4 text-lg text-muted leading-relaxed">{t(lang, 'explPageLead')}</p>
      <p class="mt-2 text-sm text-ocean/70">{t(lang, 'stackExpl')}</p>

      <div class="mt-10 space-y-8">
        <section>
          <h2 class="font-display text-xl font-bold text-ocean">{t(lang, 'explProblemTitle')}</h2>
          <p class="mt-2 text-muted leading-relaxed">{t(lang, 'explProblem')}</p>
        </section>
        <section>
          <h2 class="font-display text-xl font-bold text-ocean">{t(lang, 'explSolutionTitle')}</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-muted leading-relaxed">
            <li>{t(lang, 'explSolution1')}</li>
            <li>{t(lang, 'explSolution2')}</li>
            <li>{t(lang, 'explSolution3')}</li>
          </ul>
        </section>
        <section>
          <h2 class="font-display text-xl font-bold text-ocean">{t(lang, 'explHonestTitle')}</h2>
          <p class="mt-2 text-muted leading-relaxed">{t(lang, 'explHonest')}</p>
        </section>
      </div>

      <p class="mt-8">
        <a
          href="https://explicasurfstella.com.br"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex rounded-full bg-ocean px-4 py-2 text-sm font-semibold text-foam hover:bg-deep"
        >
          {t(lang, 'visitLive')}
        </a>
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl gap-4 sm:grid-cols-2">
      {
        shots.map((s) => (
          <figure class="overflow-hidden rounded-xl border border-ocean/10 bg-white">
            <img src={s.src} alt={s.alt} class="w-full" loading="lazy" width="1200" height="800" />
          </figure>
        ))
      }
    </div>
  </article>
</BaseLayout>
