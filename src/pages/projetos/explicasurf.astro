---
import CasePage from '../../components/CasePage.astro';

const lang = 'pt' as const;

const uiShots = [
  { src: '/images/explicasurf/explicasurf-home-stella.png', alt: 'Home ExplicaSurf — Stella Maris', caption: 'Home — Stella Maris' },
  { src: '/images/explicasurf/explicasurf-condicoes-mar.png', alt: 'Card de condições do mar e tempo', caption: 'Condições do mar e tempo' },
  { src: '/images/explicasurf/explicasurf-gerar-explicacao-ia.png', alt: 'Personalizar e gerar explicação com IA', caption: 'Gerar explicação com IA' },
  { src: '/images/explicasurf/explicasurf-card-explicacao-ui.png', alt: 'Card de explicação personalizada com TTS', caption: 'Explicação personalizada + TTS' },
  { src: '/images/explicasurf/explicasurf-grafico-ondas.png', alt: 'Gráfico de altura e período das ondas', caption: 'Gráfico de ondas' },
  { src: '/images/explicasurf/explicasurf-grafico-mare.png', alt: 'Gráfico de maré', caption: 'Gráfico de maré' },
  { src: '/images/explicasurf/explicasurf-login.png', alt: 'Tela de login do ExplicaSurf', caption: 'Login' },
];

const diagramShots = [
  { src: '/images/explicasurf/explicasurf-arquitetura.png', alt: 'Diagrama de arquitetura ExplicaSurf', caption: 'Arquitetura' },
];
---

<CasePage
  lang={lang}
  titleKey="explPageTitle"
  badgeKey="explBadge"
  leadKey="explPageLead"
  stackKey="stackExpl"
  problemTitleKey="explProblemTitle"
  problemKey="explProblem"
  solutionTitleKey="explSolutionTitle"
  solutionKeys={['explSolution1', 'explSolution2', 'explSolution3']}
  honestTitleKey="explHonestTitle"
  honestKey="explHonest"
  ctaHref="https://explicasurfstella.com.br"
  ctaLabelKey="visitLive"
  uiShots={uiShots}
  diagramShots={diagramShots}
  galleryTitle="Interface"
  diagramsTitle="Diagramas"
/>
