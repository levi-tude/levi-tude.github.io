---
import CasePage from '../../../components/CasePage.astro';

const lang = 'en' as const;

const uiShots = [
  { src: '/images/explicasurf/explicasurf-home-stella.png', alt: 'ExplicaSurf home — Stella Maris', caption: 'Home — Stella Maris' },
  { src: '/images/explicasurf/explicasurf-condicoes-mar.png', alt: 'Sea and weather conditions card', caption: 'Sea & weather conditions' },
  { src: '/images/explicasurf/explicasurf-gerar-explicacao-ia.png', alt: 'Personalize and generate AI explanation', caption: 'Generate AI explanation' },
  { src: '/images/explicasurf/explicasurf-card-explicacao-ui.png', alt: 'Personalized explanation card with TTS', caption: 'Personalized explanation + TTS' },
  { src: '/images/explicasurf/explicasurf-grafico-ondas.png', alt: 'Wave height and period chart', caption: 'Wave chart' },
  { src: '/images/explicasurf/explicasurf-grafico-mare.png', alt: 'Tide chart', caption: 'Tide chart' },
  { src: '/images/explicasurf/explicasurf-login.png', alt: 'ExplicaSurf login screen', caption: 'Login' },
];

const diagramShots = [
  { src: '/images/explicasurf/explicasurf-arquitetura.png', alt: 'ExplicaSurf architecture diagram', caption: 'Architecture' },
];
---

<CasePage
  lang={lang}
  titleKey="explPageTitle"
  badgeKey="explBadge"
  leadKey="explPageLead"
  stackKey="stackExpl"
  problemTitleKey="explProblemTitle"
  problemKey="explProblem"
  solutionTitleKey="explSolutionTitle"
  solutionKeys={['explSolution1', 'explSolution2', 'explSolution3']}
  honestTitleKey="explHonestTitle"
  honestKey="explHonest"
  ctaHref="https://explicasurfstella.com.br"
  ctaLabelKey="visitLive"
  uiShots={uiShots}
  diagramShots={diagramShots}
  galleryTitle="Interface"
  diagramsTitle="Diagrams"
/>
