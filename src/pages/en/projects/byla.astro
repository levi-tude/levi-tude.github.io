---
import CasePage from '../../../components/CasePage.astro';

const lang = 'en' as const;

const uiShots = [
  {
    src: '/images/byla/byla-visao-geral.webp',
    alt: 'Overview dashboard with fictional KPIs',
    caption:
      'Overview — monthly executive KPIs so management can follow operations without juggling spreadsheets (fictional demo data).',
  },
  {
    src: '/images/byla/byla-fluxo-operacional.webp',
    alt: 'Operational flow for students and payments',
    caption:
      'Operational flow — front desk tracks students and payments in the academy’s daily path.',
  },
  {
    src: '/images/byla/byla-entradas.webp',
    alt: 'Income entry and listing screen',
    caption:
      'Income — record and review revenue with categories and competence periods instead of loose spreadsheet cells.',
  },
  {
    src: '/images/byla/byla-despesas.webp',
    alt: 'Expenses entry and listing screen',
    caption:
      'Expenses — outflow control aligned with the official finance view for the admin role.',
  },
  {
    src: '/images/byla/byla-rbac-admin-ui.webp',
    alt: 'Administrator menu with full finance access',
    caption:
      'RBAC admin — menu with ledger access and sensitive finance modules.',
  },
  {
    src: '/images/byla/byla-rbac-secretaria-ui.webp',
    alt: 'Restricted front-desk menu',
    caption:
      'RBAC front desk — slim menu: runs the operational flow without exposing full management finance.',
  },
  {
    src: '/images/byla/byla-relatorio-ia.webp',
    alt: 'AI-assisted report with demo data',
    caption:
      'AI-assisted report — support for ops/finance analysis (demo); prompts designed to minimize PII leakage.',
  },
  {
    src: '/images/byla/byla-mobile.webp',
    alt: 'Mobile layout of the operational flow',
    caption:
      'Mobile — the same operational flow fits the staff phone on site.',
  },
];

const diagramShots = [
  {
    src: '/images/byla/byla-arquitetura.png?v=4',
    alt: 'Byla Financeiro architecture diagram',
    caption:
      'Architecture — React/TypeScript on Vercel, Node/Express API on Render, Supabase/PostgreSQL, legacy Sheets, and n8n automations. No real data.',
  },
  {
    src: '/images/byla/byla-migracao.png?v=4',
    alt: 'Gradual Google Sheets to Supabase migration diagram',
    caption:
      'Gradual migration — backend parsers/rules, spreadsheet + system dual-run, no big-bang cutover.',
  },
  {
    src: '/images/byla/byla-rbac.png?v=4',
    alt: 'RBAC permissions matrix diagram',
    caption:
      'RBAC — what admin vs front desk see in routes; official finance limited to admin.',
  },
];
---

<CasePage
  lang={lang}
  titleKey="bylaPageTitle"
  badgeKey="bylaBadge"
  leadKey="bylaPageLead"
  stackKey="stackByla"
  problemTitleKey="bylaProblemTitle"
  problemKey="bylaProblem"
  solutionTitleKey="bylaSolutionTitle"
  solutionKeys={['bylaSolution1', 'bylaSolution2', 'bylaSolution3']}
  buildTitleKey="bylaBuildTitle"
  buildKeys={['bylaBuild1', 'bylaBuild2', 'bylaBuild3']}
  ctaHref="https://github.com/levi-tude/Byla-Financeiro"
  ctaLabelKey="bylaRepo"
  uiShots={uiShots}
  diagramShots={diagramShots}
  showDemoNote={true}
  galleryTitle="Interface"
  diagramsTitle="Diagrams"
/>
