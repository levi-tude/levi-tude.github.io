---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, pathFor } from '../../../i18n/ui';

const lang = 'en' as const;

const shots = [
  { src: '/images/byla/byla-visao-geral.webp', alt: 'Overview dashboard with fictional KPIs' },
  { src: '/images/byla/byla-fluxo-operacional.webp', alt: 'Operational flow for students and payments' },
  { src: '/images/byla/byla-entradas.webp', alt: 'Income screen' },
  { src: '/images/byla/byla-despesas.webp', alt: 'Expenses screen' },
  { src: '/images/byla/byla-rbac-admin-ui.webp', alt: 'Admin menu' },
  { src: '/images/byla/byla-rbac-secretaria-ui.webp', alt: 'Front-desk restricted menu' },
  { src: '/images/byla/byla-relatorio-ia.webp', alt: 'AI-assisted report (demo)' },
  { src: '/images/byla/byla-mobile.webp', alt: 'Mobile layout of the flow' },
];
---

<BaseLayout lang={lang} title={`${t(lang, 'bylaPageTitle')} — Levi Tude`}>
  <article class="px-5 py-14">
    <div class="mx-auto max-w-3xl">
      <a href={pathFor(lang, 'home')} class="text-sm font-medium text-tide hover:text-tide-bright">{t(lang, 'backHome')}</a>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-tide">{t(lang, 'bylaBadge')}</p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ocean">{t(lang, 'bylaPageTitle')}</h1>
      <p class="mt-4 text-lg text-muted leading-relaxed">{t(lang, 'bylaPageLead')}</p>
      <p class="mt-2 text-sm text-ocean/70">{t(lang, 'stackByla')}</p>

      <div class="mt-10 space-y-8">
        <section>
          <h2 class="font-display text-xl font-bold text-ocean">{t(lang, 'bylaProblemTitle')}</h2>
          <p class="mt-2 text-muted leading-relaxed">{t(lang, 'bylaProblem')}</p>
        </section>
        <section>
          <h2 class="font-display text-xl font-bold text-ocean">{t(lang, 'bylaSolutionTitle')}</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-muted leading-relaxed">
            <li>{t(lang, 'bylaSolution1')}</li>
            <li>{t(lang, 'bylaSolution2')}</li>
            <li>{t(lang, 'bylaSolution3')}</li>
          </ul>
        </section>
        <section>
          <h2 class="font-display text-xl font-bold text-ocean">{t(lang, 'bylaHonestTitle')}</h2>
          <p class="mt-2 text-muted leading-relaxed">{t(lang, 'bylaHonest')}</p>
        </section>
      </div>

      <p class="mt-8">
        <a
          href="https://github.com/levi-tude/Byla-Financeiro"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex rounded-full bg-ocean px-4 py-2 text-sm font-semibold text-foam hover:bg-deep"
        >
          {t(lang, 'bylaRepo')}
        </a>
      </p>
    </div>

    <div class="mx-auto mt-14 max-w-5xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-tide">{t(lang, 'demoNote')}</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          shots.map((s) => (
            <figure class="overflow-hidden rounded-xl border border-ocean/10 bg-white">
              <img src={s.src} alt={s.alt} class="w-full" loading="lazy" width="1200" height="675" />
            </figure>
          ))
        }
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <img src="/images/byla/byla-arquitetura.svg" alt="Byla architecture diagram" class="rounded-xl border border-ocean/10 bg-white p-4" loading="lazy" />
        <img src="/images/byla/byla-rbac.svg" alt="RBAC permissions diagram" class="rounded-xl border border-ocean/10 bg-white p-4" loading="lazy" />
      </div>
    </div>
  </article>
</BaseLayout>
