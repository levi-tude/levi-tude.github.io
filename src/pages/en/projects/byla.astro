---
import CasePage from '../../../components/CasePage.astro';

const lang = 'en' as const;

const uiShots = [
  { src: '/images/byla/byla-visao-geral.webp', alt: 'Overview dashboard with fictional KPIs', caption: 'Overview — executive panel (demo)' },
  { src: '/images/byla/byla-fluxo-operacional.webp', alt: 'Operational flow for students and payments', caption: 'Operational flow' },
  { src: '/images/byla/byla-entradas.webp', alt: 'Income screen', caption: 'Income' },
  { src: '/images/byla/byla-despesas.webp', alt: 'Expenses screen', caption: 'Expenses' },
  { src: '/images/byla/byla-rbac-admin-ui.webp', alt: 'Admin menu', caption: 'RBAC — admin menu' },
  { src: '/images/byla/byla-rbac-secretaria-ui.webp', alt: 'Front-desk restricted menu', caption: 'RBAC — front desk' },
  { src: '/images/byla/byla-relatorio-ia.webp', alt: 'AI-assisted report (demo)', caption: 'AI-assisted report' },
  { src: '/images/byla/byla-mobile.webp', alt: 'Mobile layout of the flow', caption: 'Mobile layout' },
];

const diagramShots = [
  { src: '/images/byla/byla-arquitetura.svg', alt: 'Byla architecture diagram', caption: 'Architecture' },
  { src: '/images/byla/byla-rbac.svg', alt: 'RBAC permissions diagram', caption: 'Permissions matrix' },
];
---

<CasePage
  lang={lang}
  titleKey="bylaPageTitle"
  badgeKey="bylaBadge"
  leadKey="bylaPageLead"
  stackKey="stackByla"
  problemTitleKey="bylaProblemTitle"
  problemKey="bylaProblem"
  solutionTitleKey="bylaSolutionTitle"
  solutionKeys={['bylaSolution1', 'bylaSolution2', 'bylaSolution3']}
  honestTitleKey="bylaHonestTitle"
  honestKey="bylaHonest"
  ctaHref="https://github.com/levi-tude/Byla-Financeiro"
  ctaLabelKey="bylaRepo"
  uiShots={uiShots}
  diagramShots={diagramShots}
  showDemoNote={true}
  galleryTitle="Interface"
  diagramsTitle="Diagrams"
/>
